<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HonkTAK — Camera Goose Mapper" android:textStyle="bold" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Manually map camera observations. Sharing occurs only when you press SHARE TO TEAM and uses your currently connected TAK network." />
  <Button android:id="@+id/report_honk" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="REPORT HONK — PLACE ON MAP" />
  <Button android:id="@+id/cancel_placement" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CANCEL PLACEMENT" android:visibility="gone" />
  <LinearLayout android:id="@+id/observation_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Map location and camera aim are set by REPORT HONK placement."/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Camera class"/><Spinner android:id="@+id/camera_class" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <EditText android:id="@+id/azimuth" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Facing azimuth from map gesture" android:inputType="number" android:enabled="false"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Confidence"/><Spinner android:id="@+id/confidence" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status"/><Spinner android:id="@+id/camera_status" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <EditText android:id="@+id/notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Short notes (160 characters max)" android:maxLength="160"/>
   <EditText android:id="@+id/expiry_minutes" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Expiry minutes (1–10080)" android:inputType="number" android:text="30"/>
   <Button android:id="@+id/save_local" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SAVE LOCALLY"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SHARE TO TEAM sends this marker off-device through the currently connected TAK network. It never sends automatically or in the background." android:textStyle="bold"/>
   <Button android:id="@+id/share_team" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SHARE TO TEAM — SEND THROUGH TAK NETWORK"/>
  </LinearLayout>
  <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No camera observations currently reported."/>
 </LinearLayout>
</ScrollView>
