<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.societycharter.honktak.plugin"
    tools:ignore="GoogleAppIndexingWarning">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="26" />
    <application android:allowBackup="false" android:icon="@drawable/ic_goose"
        android:label="@string/app_name" android:description="@string/app_desc"
        android:extractNativeLibs="true" android:theme="@style/AppTheme">
        <meta-data android:name="plugin-api" android:value="com.atakmap.app@4.6.0.CIV" />
        <meta-data android:name="app_desc" android:value="@string/app_desc" />
        <activity android:name="com.atakmap.app.component" tools:ignore="MissingClass" android:exported="true">
            <intent-filter android:label="@string/app_name">
                <action android:name="com.atakmap.app.component" />
            </intent-filter>
        </activity>
    </application>
</manifest>
